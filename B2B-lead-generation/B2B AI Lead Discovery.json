    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $json;\n\nconst companyName = p.name || p.login || \"Unknown\";\nconst bio = p.bio || \"\";\nconst website = p.blog || \"\";\nconst companyInfo = companyName + \" \" + bio + \" \" + (p.company || \"\");\n\nconst relevant = /AI|artificial intelligence|automation|software|SaaS|developer tools|machine learning|technology/i.test(companyInfo);\n\nlet score = 0;\nif (relevant) score += 40;\nif (website) score += 20;\nif (bio.length > 40) score += 20;\nif (p.location) score += 10;\nif (p.public_repos > 0) score += 10;\n\nconst leadStatus =\n  score >= 70 ? \"Qualified for review\" :\n  score >= 40 ? \"Review\" :\n  \"Low priority\";\n\nreturn {\n  json: {\n    company_name: companyName,\n    github_username: p.login || \"\",\n    github_url: p.html_url || \"\",\n    website,\n    description: bio,\n    location: p.location || \"\",\n    public_repos: p.public_repos || 0,\n    lead_score: score,\n    lead_status: leadStatus,\n    source: \"GitHub REST API\",\n    source_url: p.html_url || \"\",\n    ai_subject: \"\",\n    ai_email_draft: \"\",\n    approval_status: \"Needs review\",\n    outreach_status: \"Not sent\"\n  }\n};"
      },
      "id": "9345593e-095e-4619-9b02-e50fa064ae5c",
      "name": "Normalize & Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        -160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json;\n\nconst prompt = [\n  \"You help write concise, professional B2B outreach emails.\",\n  \"\",\n  \"Draft an email for a possible business customer of an AI\",\n  \"automation and software development service.\",\n  \"\",\n  \"Use only the facts provided below.\",\n  \"Do not invent projects, customers, achievements, or business needs.\",\n  \"If there is insufficient evidence of a specific need, write a\",\n  \"general, low-pressure introduction and ask whether automation\",\n  \"is relevant to their team.\",\n  \"\",\n  \"Company: \" + lead.company_name,\n  \"Website: \" + (lead.website || \"Not available\"),\n  \"Description: \" + (lead.description || \"Not available\"),\n  \"Location: \" + (lead.location || \"Not available\"),\n  \"\",\n  \"Return ONLY valid JSON with these keys:\",\n  \"{\",\n  \"  \\\"subject\\\": \\\"Email subject\\\",\",\n  \"  \\\"body\\\": \\\"Email body\\\",\",\n  \"  \\\"reason\\\": \\\"Brief explanation of the relevance\\\",\",\n  \"  \\\"confidence\\\": \\\"Low, Medium, or High\\\"\",\n  \"}\",\n  \"\",\n  \"Do not include a fabricated recipient name or email address.\",\n  \"Keep the email under 120 words.\"\n].join(\"\\n\");\n\nreturn {\n  json: {\n    ...lead,\n    aiPrompt: prompt\n  }\n};"
      },
      "id": "a4e67aef-cefc-4416-af25-4c8aa2ff909e",
      "name": "Prepare AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        -160
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
