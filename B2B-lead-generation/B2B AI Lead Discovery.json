          "cachedResultName": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "={{ $json.aiPrompt }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "systemMessage": "You write honest, concise B2B email drafts. Never invent facts.",
          "maxOutputTokens": 800,
          "temperature": 0.3,
          "thinkingBudget": 0
        }
      },
      "id": "c5dcb4d7-7658-4493-bc4f-bb9ed9d478e0",
      "name": "Gemini AI",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1344,
        -160
      ],
