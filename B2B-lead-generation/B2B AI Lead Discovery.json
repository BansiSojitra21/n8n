    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Prepare AI Request').item.json;\nconst response = $json;\nconst parts = response.content?.parts || response.candidates?.[0]?.content?.parts || [];\nconst content = parts.map(p => p.text || \"\").join(\"\") || response.text || response.output || \"\";\n\nlet draft;\ntry {\n  const cleaned = content\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/\\s*```$/i, \"\")\n    .trim();\n  draft = JSON.parse(cleaned);\n} catch (error) {\n  draft = {\n    subject: \"\",\n    body: content || \"AI draft unavailable. Please retry.\",\n    reason: \"AI output could not be parsed as JSON.\",\n    confidence: \"Low\"\n  };\n}\n\nreturn {\n  json: {\n    company_name: lead.company_name,\n    github_username: lead.github_username,\n    github_url: lead.github_url,\n    website: lead.website,\n    description: lead.description,\n    location: lead.location,\n    public_repos: lead.public_repos,\n    lead_score: lead.lead_score,\n    lead_status: lead.lead_status,\n    source: lead.source,\n    source_url: lead.source_url,\n    ai_subject: draft.subject || \"\",\n    ai_email_draft: draft.body || \"\",\n    ai_reason: draft.reason || \"\",\n    ai_confidence: draft.confidence || \"Low\",\n    approval_status: \"Needs review\",\n    outreach_status: \"Not sent\"\n  }\n};"
      },
